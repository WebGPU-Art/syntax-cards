{
  "name": "syntax-cards",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "yarn@4.18.0",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test src/*.test.ts",
    "build": "yarn check && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "examples:refresh": "node scripts/extract-examples.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^6.1.0"
  },
  "dependencies": {
    "@cirru/parser.ts": "0.0.10"
  }
}
